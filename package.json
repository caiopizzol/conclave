{
	"name": "conclave",
	"version": "1.0.0",
	"description": "A local console for coding-agent handoffs. Persistent advisor sessions per worktree, native vendor resume.",
	"scripts": {
		"register": "bash scripts/register.sh",
		"unregister": "bash scripts/unregister.sh",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit",
		"prepare": "lefthook install",
		"release": "semantic-release"
	},
	"keywords": [
		"ai",
		"multi-model",
		"claude-code",
		"codex",
		"advisor",
		"agent-handoff",
		"harness"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.8",
		"@types/bun": "^1.3.14",
		"lefthook": "^2.1.8",
		"semantic-release": "^25.0.3",
		"semantic-release-ai-notes": "^0.3.0",
		"typescript": "^6.0.3"
	}
}
