{
	"persistence": {
		"enabled": true,
		"required": false,
		"data_dir": "~/.local/share/conclave/reviews"
	},
	"tools": {
		"codex": {
			"enabled": true,
			"scope": ["review", "consult"],
			"command": "codex exec --full-auto -m gpt-5.2-codex -",
			"model": "gpt-5.2-codex",
			"description": "OpenAI Codex CLI"
		},
		"claude-opus": {
			"enabled": true,
			"scope": ["review", "consult"],
			"command": "CLAUDECODE=0 claude --print --model opus",
			"model": "opus",
			"description": "Claude Code (Opus)"
		},
		"claude-sonnet": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "CLAUDECODE=0 claude --print --model sonnet",
			"model": "sonnet",
			"description": "Claude Code (Sonnet)"
		},
		"gemini": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "gemini -o text",
			"description": "Google Gemini CLI (uses default model)"
		},
		"qwen": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "qwen -o text",
			"description": "Qwen Code (Alibaba)"
		},
		"mistral": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "vibe --output text -p",
			"description": "Mistral Vibe (Devstral)"
		},
		"grok": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "grok -p -m grok-code-fast-1",
			"model": "grok-code-fast-1",
			"description": "xAI Grok CLI (community)"
		},
		"ollama-minimax": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "ollama run minimax-m2.5:cloud",
			"model": "minimax-m2.5:cloud",
			"description": "Ollama (MiniMax M2.5, cloud)"
		},
		"ollama-glm": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "ollama run glm-5:cloud",
			"model": "glm-5:cloud",
			"description": "Ollama (GLM-5, cloud)"
		},
		"ollama-kimi": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "ollama run kimi-k2.5:cloud",
			"model": "kimi-k2.5:cloud",
			"description": "Ollama (Kimi K2.5, cloud)"
		},
		"ollama-qwen": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "ollama run qwen3-coder:480b-cloud",
			"model": "qwen3-coder:480b-cloud",
			"description": "Ollama (Qwen3 Coder 480B, cloud)"
		},
		"ollama-devstral": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "ollama run devstral-2:123b-cloud",
			"model": "devstral-2:123b-cloud",
			"description": "Ollama (Devstral 2 123B, cloud)"
		},
		"ollama-deepseek": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "ollama run deepseek-v3.2:cloud",
			"model": "deepseek-v3.2:cloud",
			"description": "Ollama (DeepSeek V3.2, cloud)"
		},
		"ollama-rnj": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "ollama run rnj-1:8b-cloud",
			"model": "rnj-1:8b-cloud",
			"description": "Ollama (RNJ-1 8B, cloud)"
		},
		"ollama-devstral-small": {
			"enabled": false,
			"scope": ["review", "consult"],
			"command": "ollama run devstral-small-2:24b-cloud",
			"model": "devstral-small-2:24b-cloud",
			"description": "Ollama (Devstral Small 2 24B, cloud)"
		},
		"ollama-local": {
			"enabled": false,
			"scope": ["review"],
			"command": "ollama run qwen2.5-coder:7b",
			"model": "qwen2.5-coder:7b",
			"description": "Ollama (Qwen 2.5 Coder 7B, local)"
		}
	},
	"prompts": {
		"review": "~/.config/conclave/prompt.md",
		"consult": "~/.config/conclave/consult-prompt.md"
	}
}
